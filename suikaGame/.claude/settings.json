{
    "permissions": {
    "allow": [
      "Read",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(dotnet csharpier *)"
    ],
    "deny": [
      "Read(./Library/**)",
      "Read(!./Library/PackageCache/**)",
      "Read(./Temp/**)",
      "Read(./Logs/**)",
      "Read(./obj/**)",
      "Read(./**/*.csproj)",
      "Read(./**/*.sln)",
      "Write(./**/*.meta)",
      "Edit(./**/packages-lock.json)",
      "Edit(./**/*.unity)",
      "Write(./**/*.unity)",
      "Bash(rm -rf *)"
    ],
    "defaultMode": "default"
  },

    "hooks": {
        "PostToolUse": [
        {
            "matcher": "Write|Edit",
            "hooks": [
            {
                "type": "command",
                "shell": "powershell",
                "command": "if ($env:CLAUDE_TOOL_INPUT_FILE_PATH -like '*.cs') { dotnet csharpier format $env:CLAUDE_TOOL_INPUT_FILE_PATH }"
            }
            ]
        }
        ]
    }
}
